{
  "manifest_version": 3,
  "name": "Agent URL Bridge",
  "version": "1.0",
  "description": "Sends the active tab URL to an AI agent backend.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Send URL to Agent"
  },
  "background": {
    "service_worker": "background.js"
  }
}
